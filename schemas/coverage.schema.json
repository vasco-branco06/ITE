{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "S-001",
  "title": "Coverage",
  "description": "Interview state stored in .ite/coverage.json. Used by R-002, R-005, R-006, R-007, R-008, R-024.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "idea", "language", "created_at", "updated_at", "approved_at", "mode", "question_budget", "areas", "history", "stop_reason"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1, "maximum": 1 },
    "idea": { "type": "string", "minLength": 3, "maxLength": 20000, "description": "Idea text as the user wrote it" },
    "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$", "description": "BCP-47 short tag of the interview language" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "approved_at": { "type": ["string", "null"], "format": "date-time", "description": "Set when the user approves the tests (R-020)" },
    "mode": { "type": "string", "enum": ["scripted", "manual"] },
    "question_budget": { "type": ["integer", "null"], "minimum": 1, "maximum": 25, "description": "Question turns before the stop offer (R-024); null = no budget" },
    "stop_reason": { "type": ["string", "null"], "enum": ["complete", "user_stopped", null] },
    "areas": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/Area" }
    },
    "history": {
      "type": "array",
      "items": { "$ref": "#/$defs/Turn" }
    }
  },
  "$defs": {
    "Area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "summary", "decision_ids", "test_ids", "reason"],
      "properties": {
        "id": { "type": "string", "enum": ["goal", "users", "scope", "inputs", "outputs", "integrations", "security", "stack", "llm", "errors", "acceptance", "done"] },
        "state": { "type": "string", "enum": ["open", "clear", "assumed", "not_applicable"] },
        "summary": { "type": ["string", "null"], "maxLength": 2000 },
        "decision_ids": { "type": "array", "items": { "type": "string", "pattern": "^D-[0-9]{3}$" } },
        "test_ids": { "type": "array", "items": { "type": "string", "pattern": "^T-[0-9]{3}$" } },
        "reason": { "type": ["string", "null"], "maxLength": 500, "description": "Required when state is not_applicable" }
      }
    },
    "Turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "area", "question", "recommended", "answer", "accepted_recommendation", "at"],
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "kind": { "type": "string", "enum": ["question", "stop_offer"], "description": "Missing = question" },
        "area": { "type": "string" },
        "question": { "type": "string" },
        "recommended": { "type": "string" },
        "answer": { "type": ["string", "null"] },
        "accepted_recommendation": { "type": "boolean" },
        "corrects": { "type": "integer", "minimum": 1, "description": "History entry this one corrects" },
        "at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
