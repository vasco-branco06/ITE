{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "S-002",
  "title": "TestCases",
  "description": "Structured test cases in tests/cases.json. Used by R-012.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1, "maximum": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Case" } }
  },
  "$defs": {
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "proves", "kind", "given", "when", "then"],
      "properties": {
        "id": { "type": "string", "pattern": "^T-[0-9]{3}$" },
        "title": { "type": "string", "maxLength": 120 },
        "proves": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(R|D)-[0-9]{3}$" } },
        "kind": { "type": "string", "enum": ["unit", "integration", "e2e", "prompt", "assumption", "manual"] },
        "given": { "type": "string" },
        "when": { "type": "string" },
        "then": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "schema": { "type": "string", "pattern": "^S-[0-9]{3}$", "description": "Schema that input/expected must satisfy" },
        "input": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "expected": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "phase": { "type": "string", "pattern": "^F-[0-9]+(\\.[0-9]+)*$" }
      }
    }
  }
}
